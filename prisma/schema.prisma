generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CompanyMaster {
  cid                     Int     @id @default(autoincrement())
  companyCode             String  @unique @map("company_code")
  companyName             String  @map("company_name")
  isActive                Boolean @default(true) @map("is_active")
  panNo                   String? @map("pan_no")
  tanNo                   String? @map("tan_no")
  regdOfficeAddress       String? @map("regd_office_address")
  companyLogoFileLocation String? @map("company_logo_file_location")

  users        UserDetails[]
  menus        MenuMaster[]
  roles        RoleMaster[]
  roleMenuMaps RoleMenuMap[]
  apps         AppMaster[]
  tickets      Ticket[]

  @@map("company_master")
}

/**
 * One product/application within a company. A user's access to an app is never stored
 * directly — it is derived: user -> roles -> role_menu_map -> menu -> app
 * (see getAppsForUser in src/lib/apps.ts).
 */
model AppMaster {
  appCode      String  @id @map("app_code")
  appName      String  @map("app_name")
  companyCode  String  @map("company_code")
  description  String?
  icon         String? // emoji, used when appLogoUrl is not set
  appLogoUrl   String? @map("app_logo_url")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  company CompanyMaster @relation(fields: [companyCode], references: [companyCode])
  menus   MenuMaster[]

  @@map("app_master")
}

model HierarchyMaster {
  uid           Int     @id @default(autoincrement())
  hierarchyCode String  @unique @map("hierarchy_code")
  hierarchyName String  @map("hierarchy_name")
  description   String?
  isActive      Boolean @default(true) @map("is_active")
  seqId         String  @map("seq_id")

  users         UserDetails[]
  menus         MenuMaster[]
  roles         RoleMaster[]
  roleMenuMaps  RoleMenuMap[]
  notifications Notification[]

  @@map("hierarchy_master")
}

model ClientCategoryMaster {
  clientCategoryCode String  @id @map("client_category_code")
  clientCategoryName String  @map("client_category_name")
  isActive           Boolean @default(true) @map("is_active")

  users UserDetails[]

  @@map("client_category_master")
}

model UserDetails {
  uid                     Int       @id @default(autoincrement())
  companyCode             String    @map("company_code")
  username                String    @unique
  passwordHash            String    @map("password_hash")
  customerId              String?   @map("customer_id")
  fullName                String    @map("full_name")
  mobile                  String?
  email                   String?
  lastPasswordChangedDate DateTime? @map("last_password_changed_date")
  createdDate             DateTime  @default(now()) @map("created_date")
  modifiedDate            DateTime? @updatedAt @map("modified_date")
  hierarchyCode           String    @map("hierarchy_code")
  clientCategoryCode      String    @default("C00") @map("client_category_code")
  isActive                Boolean   @default(true) @map("is_active")
  /// Last app this user opened — reopened automatically on next login. No FK: an app
  /// that's deleted or revoked just falls back to the user's first accessible app.
  lastAppCode             String?   @map("last_app_code")

  company        CompanyMaster        @relation(fields: [companyCode], references: [companyCode])
  hierarchy      HierarchyMaster      @relation(fields: [hierarchyCode], references: [hierarchyCode])
  clientCategory ClientCategoryMaster @relation(fields: [clientCategoryCode], references: [clientCategoryCode])

  passwordHistory PasswordHistory[]
  ipMappings      UserIpMapping[]
  loginLogs       LoginLog[]
  userRoles       UserRoleMap[]
  favoriteMenus   UserFavoriteMenu[]
  sentNotifications   Notification[]     @relation("SentNotifications")
  directNotifications Notification[]     @relation("DirectNotifications")
  notificationReads   NotificationRead[]

  // Issue tracker (docs/04-issue-tracker-brs.md). Every one of these is onDelete: Restrict
  // on the owning side — attribution has to survive, and this app deactivates users rather
  // than deleting them. Note that ticket_event deliberately has NO relation here: audit
  // rows denormalise the username so they outlive the user, as menu_usage_log does.
  ticketsRaised            Ticket[]         @relation("TicketRaiser")
  ticketsOnBehalf          Ticket[]         @relation("TicketOnBehalf")
  ticketsAssigned          Ticket[]         @relation("TicketAssignee")
  changeRequestsRaised     ChangeRequest[]  @relation("CrRequestedBy")
  changeRequestsApproved   ChangeRequest[]  @relation("CrApprovedBy")
  serviceRequestsRaised    ServiceRequest[] @relation("SrRequestedBy")
  serviceRequestsForClient ServiceRequest[] @relation("SrForClient")

  @@index([companyCode])
  @@map("user_details")
}

model PasswordHistory {
  id           Int      @id @default(autoincrement())
  userUid      Int      @map("user_uid")
  passwordHash String   @map("password_hash")
  changedDate  DateTime @default(now()) @map("changed_date")

  user UserDetails @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@index([userUid])
  @@map("password_history")
}

model UserIpMapping {
  id        Int     @id @default(autoincrement())
  userUid   Int     @map("user_uid")
  ipMapping String  @map("ip_mapping")
  isActive  Boolean @default(true) @map("is_active")

  user UserDetails @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@index([userUid])
  @@map("user_ip_mapping")
}

model LoginLog {
  id            Int      @id @default(autoincrement())
  username      String
  userUid       Int?     @map("user_uid")
  loginTime     DateTime @default(now()) @map("login_time")
  status        String
  failureReason String?  @map("failure_reason")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")

  user UserDetails? @relation(fields: [userUid], references: [uid])

  @@index([userUid])
  @@map("login_logs")
}

model MenuMaster {
  menuCode       String  @id @map("menu_code")
  parentMenuCode String? @map("parent_menu_code")
  menuName       String  @map("menu_name")
  icon           String?
  routePath      String? @map("route_path")
  level          Int
  displayOrder   Int     @default(0) @map("display_order")
  companyCode    String  @map("company_code")
  hierarchyCode  String  @map("hierarchy_code")
  menuType       String  @default("ROUTE") @map("menu_type") // ROUTE | REPORT | EXTERNAL
  externalUrl    String? @map("external_url")
  reportId       String? @map("report_id")
  /// Which app this menu belongs to. NULL means "global" — shown in every app (this is
  /// what keeps Administration reachable no matter which app is selected).
  appCode        String? @map("app_code")
  isActive       Boolean @default(true) @map("is_active")

  parent   MenuMaster?  @relation("MenuTree", fields: [parentMenuCode], references: [menuCode])
  children MenuMaster[] @relation("MenuTree")

  app       AppMaster?        @relation(fields: [appCode], references: [appCode])
  company   CompanyMaster     @relation(fields: [companyCode], references: [companyCode])
  hierarchy HierarchyMaster   @relation(fields: [hierarchyCode], references: [hierarchyCode])
  report    ReportDefinition? @relation(fields: [reportId], references: [reportId])
  roleMaps  RoleMenuMap[]
  favoritedBy UserFavoriteMenu[]

  @@index([appCode])
  @@index([parentMenuCode])
  @@index([companyCode, hierarchyCode])
  @@map("menu_master")
}

model RoleMaster {
  roleCode      String  @id @map("role_code")
  roleName      String  @map("role_name")
  companyCode   String  @map("company_code")
  hierarchyCode String  @map("hierarchy_code")
  isActive      Boolean @default(true) @map("is_active")

  company   CompanyMaster   @relation(fields: [companyCode], references: [companyCode])
  hierarchy HierarchyMaster @relation(fields: [hierarchyCode], references: [hierarchyCode])
  menuMaps  RoleMenuMap[]
  userRoles UserRoleMap[]

  @@map("role_master")
}

model RoleMenuMap {
  id            Int     @id @default(autoincrement())
  roleCode      String  @map("role_code")
  menuCode      String  @map("menu_code")
  companyCode   String  @map("company_code")
  hierarchyCode String  @map("hierarchy_code")
  isActive      Boolean @default(true) @map("is_active")

  role      RoleMaster      @relation(fields: [roleCode], references: [roleCode])
  menu      MenuMaster      @relation(fields: [menuCode], references: [menuCode])
  company   CompanyMaster   @relation(fields: [companyCode], references: [companyCode])
  hierarchy HierarchyMaster @relation(fields: [hierarchyCode], references: [hierarchyCode])

  @@unique([roleCode, menuCode, companyCode, hierarchyCode])
  @@index([companyCode, hierarchyCode, roleCode])
  @@index([menuCode])
  @@map("role_menu_map")
}

model UserRoleMap {
  id       Int     @id @default(autoincrement())
  userUid  Int     @map("user_uid")
  roleCode String  @map("role_code")
  isActive Boolean @default(true) @map("is_active")

  user UserDetails @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  role RoleMaster  @relation(fields: [roleCode], references: [roleCode])

  @@unique([userUid, roleCode])
  @@map("user_role_map")
}

/// Phase-1 capture-only queue for Forgot User ID / Reset Password requests,
/// since the real OTP/email delivery service isn't live yet.
model AccountRequest {
  id          Int      @id @default(autoincrement())
  username    String?
  requestType String   @map("request_type")
  contact     String?
  status      String   @default("PENDING")
  createdDate DateTime @default(now()) @map("created_date")

  @@map("account_requests")
}

/// Phase 3: reusable filter/form component repository. A component is pure
/// and reusable (e.g. "Branch Dropdown") — whether it cascades from another
/// component is decided per-usage in FilterDefinitionItem, not here.
model FilterComponentMaster {
  componentCode     String  @id @map("component_code")
  componentName     String  @map("component_name")
  componentType     String  @map("component_type") // TEXT | NUMBER | DATE | DATE_RANGE | DROPDOWN | MULTI_SELECT | CHECKBOX | RADIO
  dataSourceType    String  @default("NONE") @map("data_source_type") // STATIC | SQL | NONE
  staticOptionsJson String? @map("static_options_json")
  dataSourceQuery   String? @map("data_source_query")
  isActive          Boolean @default(true) @map("is_active")

  filterItems FilterDefinitionItem[]

  @@map("filter_component_master")
}

/// The FilterID header — a named, reusable arrangement of filter components.
model FilterDefinition {
  filterId         String  @id @map("filter_id")
  filterName       String  @map("filter_name")
  isCollapsible    Boolean @default(true) @map("is_collapsible")
  defaultCollapsed Boolean @default(false) @map("default_collapsed")
  isActive         Boolean @default(true) @map("is_active")

  items   FilterDefinitionItem[]
  reports ReportDefinition[]

  @@map("filter_definition")
}

/// One component's placement within a FilterID: grid position, whether it's
/// mandatory in this arrangement, and (for FORM mode) which target-table
/// column it maps to. dependsOnItemId makes cascading a per-arrangement
/// property of the placement, not the component.
model FilterDefinitionItem {
  id              Int     @id @default(autoincrement())
  filterId        String  @map("filter_id")
  componentCode   String  @map("component_code")
  rowNo           Int     @map("row_no")
  positionNo      Int     @map("position_no")
  isMandatory     Boolean @default(false) @map("is_mandatory")
  labelOverride   String? @map("label_override")
  defaultValue    String? @map("default_value")
  mappedColumn    String? @map("mapped_column")
  dependsOnItemId Int?    @map("depends_on_item_id")
  isActive        Boolean @default(true) @map("is_active")

  filter    FilterDefinition      @relation(fields: [filterId], references: [filterId], onDelete: Cascade)
  component FilterComponentMaster @relation(fields: [componentCode], references: [componentCode])

  dependsOn  FilterDefinitionItem?  @relation("ItemDependency", fields: [dependsOnItemId], references: [id], onDelete: SetNull)
  dependents FilterDefinitionItem[] @relation("ItemDependency")

  @@index([filterId])
  @@map("filter_definition_item")
}

/// The ReportID header — mapped to a FilterID, either a REPORT (runs queryText
/// and displays/exports results) or a FORM (queryText is the "my saved
/// records" list; targetTable + each item's mappedColumn drive save/edit/delete).
model ReportDefinition {
  reportId          String   @id @map("report_id")
  reportTitle       String   @map("report_title")
  filterId          String   @map("filter_id")
  mode              String   @default("REPORT") @map("mode") // REPORT | FORM
  queryText         String   @map("query_text")
  targetTable       String?  @map("target_table")
  /// When set, the engine wraps this report's results with `WHERE <column> = <caller's
  /// company>`. Enforced in SQL exactly as FORM-mode ownership is, so cross-company
  /// leakage cannot happen merely because a query author forgot a predicate.
  companyScopeColumn String? @map("company_scope_column")
  maxRows           Int      @default(2000) @map("max_rows")
  freezeColumns     Int      @default(0) @map("freeze_columns")
  displayStyle      String   @default("PAGED") @map("display_style") // PAGED | FULL_FROZEN
  footerNote        String?  @map("footer_note")
  allowedFormats    String[] @default(["CSV"]) @map("allowed_formats")
  allowedDeliveries String[] @default(["DOWNLOAD"]) @map("allowed_deliveries")
  isActive          Boolean  @default(true) @map("is_active")

  filter             FilterDefinition         @relation(fields: [filterId], references: [filterId])
  columns            ReportColumn[]
  highlightRules     ReportRowHighlightRule[]
  menuItems          MenuMaster[]
  drilledFromColumns ReportColumn[]           @relation("ColumnDrillDownTarget")
  serviceRequests    ServiceRequest[]

  @@map("report_definition")
}

/// Per-report column display config. columnKey must match the alias/name a
/// column comes back as from queryText.
model ReportColumn {
  id            Int     @id @default(autoincrement())
  reportId      String  @map("report_id")
  columnKey     String  @map("column_key")
  displayLabel  String  @map("display_label")
  displayOrder  Int     @default(0) @map("display_order")
  isHighlighted Boolean @default(false) @map("is_highlighted")
  isIdentifier  Boolean @default(false) @map("is_identifier")
  // Drives display formatting, alignment, and sort comparator — see CLAUDE.md
  // "Date/number column formatting" rule. TEXT | NUMBER | DATE | DATETIME.
  dataType      String  @default("TEXT") @map("data_type")
  decimalPlaces Int?    @map("decimal_places")
  // NUMBER columns only — sums the column across the result set into a footer total row.
  showTotal     Boolean @default(false) @map("show_total")

  // Drill-down: clicking a cell in this column opens drillDownReport, passing this cell's
  // value into drillDownTargetParam. See CLAUDE.md "Report drill-down" rule for the
  // plain-string vs JSON-discriminator convention on drillDownTargetParam, and for how
  // the rest of the current filter values carry over automatically.
  drillDownReportId    String? @map("drill_down_report_id")
  drillDownTargetParam String? @map("drill_down_target_param")
  drillDownMode        String  @default("PAGE") @map("drill_down_mode") // PAGE ("Normal" in the admin UI) | MODAL ("Popup")
  drillDownModalSize   String  @default("AUTO") @map("drill_down_modal_size") // AUTO | SMALL | MEDIUM | LARGE

  report          ReportDefinition  @relation(fields: [reportId], references: [reportId], onDelete: Cascade)
  drillDownReport ReportDefinition? @relation("ColumnDrillDownTarget", fields: [drillDownReportId], references: [reportId], onDelete: SetNull)

  @@index([reportId])
  @@map("report_column")
}

/// Conditional row-highlight rules, e.g. "status = FAILURE" -> red.
model ReportRowHighlightRule {
  id             Int    @id @default(autoincrement())
  reportId       String @map("report_id")
  columnKey      String @map("column_key")
  operator       String // EQ | NEQ | GT | LT | GTE | LTE | CONTAINS
  compareValue   String @map("compare_value")
  highlightColor String @map("highlight_color")
  priority       Int    @default(0)

  report ReportDefinition @relation(fields: [reportId], references: [reportId], onDelete: Cascade)

  @@index([reportId])
  @@map("report_row_highlight_rule")
}

/// A user's favorited menu item (heart icon in the top bar), surfaced as
/// horizontally-scrolling cards on the dashboard.
model UserFavoriteMenu {
  id        Int      @id @default(autoincrement())
  userUid   Int      @map("user_uid")
  menuCode  String   @map("menu_code")
  createdOn DateTime @default(now()) @map("created_on")

  user UserDetails @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  menu MenuMaster  @relation(fields: [menuCode], references: [menuCode], onDelete: Cascade)

  @@unique([userUid, menuCode])
  @@map("user_favorite_menu")
}

/// An admin-sent message, targeted at either a whole hierarchy or one specific user.
/// scheduledFor needs no worker/cron to act on it — a recipient simply doesn't see
/// the message in their applicable-notifications query until scheduledFor has passed
/// (or immediately, if left blank). See CLAUDE.md "Notifications" rule.
model Notification {
  id                   Int       @id @default(autoincrement())
  senderUid            Int       @map("sender_uid")
  targetType           String    @map("target_type") // HIERARCHY | USER
  targetHierarchyCode  String?   @map("target_hierarchy_code")
  targetUserUid        Int?      @map("target_user_uid")
  deliveryPopup        Boolean   @default(false) @map("delivery_popup")
  deliveryBell         Boolean   @default(true) @map("delivery_bell")
  messageText          String    @map("message_text")
  scheduledFor         DateTime? @map("scheduled_for")
  createdAt            DateTime  @default(now()) @map("created_at")
  isActive             Boolean   @default(true) @map("is_active")

  sender          UserDetails      @relation("SentNotifications", fields: [senderUid], references: [uid])
  targetHierarchy HierarchyMaster? @relation(fields: [targetHierarchyCode], references: [hierarchyCode])
  targetUser      UserDetails?     @relation("DirectNotifications", fields: [targetUserUid], references: [uid])
  reads           NotificationRead[]

  @@index([targetUserUid])
  @@index([targetHierarchyCode])
  @@map("notification")
}

/// Per-user read state — a notification has no fixed recipient list (hierarchy
/// targeting resolves dynamically), so read state is tracked per (notification, user)
/// pair rather than as a column on Notification itself.
model NotificationRead {
  id             Int      @id @default(autoincrement())
  notificationId Int      @map("notification_id")
  userUid        Int      @map("user_uid")
  readAt         DateTime @default(now()) @map("read_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         UserDetails   @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@unique([notificationId, userUid])
  @@index([userUid])
  @@map("notification_read")
}

/**
 * Append-only log of menu selections, kept for 7 days (see MENU_USAGE_RETENTION_DAYS).
 *
 * Deliberately has NO foreign keys and denormalises company/app/menu names: inserts sit on
 * the click path, so they skip constraint checks entirely, and a log row stays meaningful
 * after the menu or user it refers to is deleted.
 */
model MenuUsageLog {
  id          Int      @id @default(autoincrement())
  userUid     Int      @map("user_uid")
  username    String
  companyCode String   @map("company_code")
  appCode     String?  @map("app_code")
  menuCode    String   @map("menu_code")
  menuName    String   @map("menu_name")
  /// Top-level menu the selection sits under, e.g. "Utilities". Null when the item is itself top-level.
  mainMenu    String?  @map("main_menu")
  /// Second-level menu, e.g. "Sample". Null for items only one level deep.
  subMenu     String?  @map("sub_menu")
  routePath   String?  @map("route_path")
  selectedAt  DateTime @default(now()) @map("selected_at")

  @@index([selectedAt])
  @@index([userUid, selectedAt])
  @@map("menu_usage_log")
}

// ---------------------------------------------------------------------------
// Issue Tracker & Service Request System — Phase 1.
// Spec: docs/04-issue-tracker-brs.md. Migration: 20260805103000_issue_tracker_phase1.
// Status/type columns are String + an enumerating comment, matching menuType,
// componentType and targetType above rather than introducing Prisma enums.
// ---------------------------------------------------------------------------

/// Predefined issue taxonomy on two axes: product/module x issue type (BRS §4.3).
/// Owned reactively by the support lead — no fixed review cadence. The axes are separate
/// columns rather than one opaque label because the §4.8 stats reports (and the Phase 2
/// CEO dashboard) group by them.
model IssueCategory {
  categoryCode  String  @id @map("category_code")
  categoryName  String  @map("category_name")
  productModule String  @map("product_module")
  issueType     String  @map("issue_type") // QUERY | COMPLAINT | BUG | SERVICE_REQUEST
  description   String?
  displayOrder  Int     @default(0) @map("display_order")
  isActive      Boolean @default(true) @map("is_active")

  tickets Ticket[]

  @@index([isActive, displayOrder])
  @@index([productModule, issueType])
  @@map("issue_category")
}

/// One issue thread. Never hard-deleted — merge and closure are state changes, so the
/// audit trail in TicketEvent always resolves to a live row (BRS §5, dispute resolution).
model Ticket {
  id Int @id @default(autoincrement())
  /// Allocated by a Postgres sequence default, so no intake path can create a ticket
  /// without a number and concurrent intake across four channels cannot collide. The year
  /// is a display prefix only — the sequence does not reset annually, so a number is never
  /// reused.
  ticketNo String @unique @default(dbgenerated("((('TKT-'::text || to_char((CURRENT_DATE)::timestamp with time zone, 'YYYY'::text)) || '-'::text) || lpad((nextval('ticket_no_seq'::regclass))::text, 6, '0'::text))")) @map("ticket_no")

  /// NULL for a guest ticket (§4.2), backfilled on reconciliation. The guest* columns are
  /// never cleared, so the row always shows what was actually captured at intake.
  raiserUid     Int?    @map("raiser_uid")
  raiserType    String  @map("raiser_type") // EMPLOYEE | CLIENT | PARTNER | PROSPECT | GUEST
  guestName     String? @map("guest_name")
  guestEmail    String? @map("guest_email")
  guestMobile   String? @map("guest_mobile")
  /// Set when an employee logs a ticket for a client (phone / WhatsApp intake).
  onBehalfOfUid Int?    @map("on_behalf_of_uid")
  clientCode    String? @map("client_code")

  channel String // WEBSITE | WHATSAPP | PHONE | SYNAPSE

  /// Classification on three independent axes, replacing the single combined category.
  /// Type is a fixed list (a reporting dimension shouldn't drift into near-duplicates);
  /// application and segment are master data the desk extends as new ones appear.
  ticketType    String  @map("ticket_type") // ISSUE | COMPLAINT | BUG | REQUEST | CLARIFICATION | OTHERS
  /// Required when ticketType is OTHERS — the "please mention" free text.
  typeOther     String? @map("type_other")
  applicationId Int     @map("application_id")
  segmentId     Int     @map("segment_id")

  /// Superseded by the three axes above. Left nullable rather than dropped so the column
  /// and any historical classification survive; nothing sets it on new tickets.
  categoryCode String? @map("category_code")

  subject     String
  description String
  companyCode String @map("company_code")

  status        String    @default("OPEN")
  // OPEN | IN_PROGRESS | FORWARDED | AWAITING_CR_APPROVAL | RESOLVED | CLOSED | MERGED
  assignedToUid Int?      @map("assigned_to_uid")
  revisedEta    DateTime? @map("revised_eta")

  /// Immutable: when THIS ticket was actually raised. Never rewritten, including by merge.
  raisedAt        DateTime  @default(now()) @map("raised_at")
  /// The turnaround clock (§4.4 — confirmed rule: the earlier of the two on merge).
  /// Normally equals raisedAt. Deliberately has no default: a back-dated phone ticket must
  /// not silently start its clock at now() and understate the §4.8 turnaround metric.
  slaClockStartAt DateTime  @map("sla_clock_start_at")
  firstResponseAt DateTime? @map("first_response_at")
  resolvedAt      DateTime? @map("resolved_at")
  closedAt        DateTime? @map("closed_at")

  /// Set on the ABSORBED ticket, pointing at the surviving thread. Non-null means this row
  /// is no longer tracked separately — reports filter `mergedIntoTicketId: null` so a
  /// merged pair counts once.
  mergedIntoTicketId Int?      @map("merged_into_ticket_id")
  mergedAt           DateTime? @map("merged_at")

  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  updatedOn DateTime @default(now()) @updatedAt @map("updated_on")

  category    IssueCategory?    @relation(fields: [categoryCode], references: [categoryCode])
  application ApplicationMaster @relation(fields: [applicationId], references: [id])
  segment     SegmentMaster     @relation(fields: [segmentId], references: [id])
  company     CompanyMaster     @relation(fields: [companyCode], references: [companyCode])
  raiser     UserDetails?  @relation("TicketRaiser", fields: [raiserUid], references: [uid], onDelete: Restrict)
  onBehalfOf UserDetails?  @relation("TicketOnBehalf", fields: [onBehalfOfUid], references: [uid], onDelete: Restrict)
  assignedTo UserDetails?  @relation("TicketAssignee", fields: [assignedToUid], references: [uid], onDelete: Restrict)

  mergedInto    Ticket?  @relation("TicketMerge", fields: [mergedIntoTicketId], references: [id], onDelete: Restrict)
  mergedTickets Ticket[] @relation("TicketMerge")

  attachments   TicketAttachment[]
  events        TicketEvent[]    @relation("TicketEventTicket")
  relatedEvents TicketEvent[]    @relation("TicketEventRelated")
  changeRequest ChangeRequest?
  messages      ChannelMessage[]

  @@index([status, raisedAt])
  @@index([assignedToUid, status])
  @@index([companyCode, raisedAt])
  @@index([mergedIntoTicketId])
  @@index([raiserUid, status])
  /// Serves the §4.4 duplicate probe: same category + still open + inside a rolling window.
  @@index([categoryCode, status, raisedAt])
  /// Serves the §4.4 duplicate probe on the new axes: same application + type + still open
  /// + inside the rolling window.
  @@index([applicationId, ticketType, status, raisedAt])
  @@index([segmentId])
  @@map("ticket")
}

/// A file attached to a ticket. Bytes live here rather than on disk: BRS §5 requires no new
/// datastore, and the app container is ephemeral. Caps are enforced in
/// `src/lib/attachment-core.ts` and backed by a CHECK constraint on byteSize.
///
/// Never select `content` in a list query — Postgres keeps it out of the main heap, and
/// asking for it drags every row's bytes back with the listing.
model TicketAttachment {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  byteSize   Int      @map("byte_size")
  content    Bytes
  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("ticket_attachment")
}

/// The application a ticket is about (Trading Terminal, Back Office, RMS …). Master data
/// rather than a fixed list: §4.3 has the desk extending the taxonomy as patterns emerge,
/// and the raise screen can add one inline when it is missing.
model ApplicationMaster {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  createdBy    String? @map("created_by")

  tickets Ticket[]

  @@index([isActive, displayOrder])
  @@map("application_master")
}

/// The market segment a ticket relates to (Equity Cash, F&O, Currency …), including an
/// explicit "Not Applicable" for issues that aren't segment-specific — so the field can stay
/// mandatory without forcing a misleading answer.
model SegmentMaster {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  createdBy    String? @map("created_by")

  tickets Ticket[]

  @@index([isActive, displayOrder])
  @@map("segment_master")
}

/// Append-only audit trail (§4.5): never updated, never deleted.
///
/// No relations to UserDetails and usernames are denormalised — same reasoning as
/// MenuUsageLog. A row used to settle a dispute months later must stay readable after the
/// user it names is removed or renamed. ticketId IS a real relation, since events are only
/// ever read in the context of a ticket that must therefore still exist.
model TicketEvent {
  id        Int    @id @default(autoincrement())
  ticketId  Int    @map("ticket_id")
  eventType String @map("event_type")
  // CREATED | STATUS_CHANGE | FORWARD | ASSIGN | REMARK | ETA_REVISED | MERGE
  // | IDENTITY_RECONCILED | CR_PROPOSED | CR_APPROVED | CR_REJECTED | NOTIFICATION

  fromStatus String? @map("from_status")
  toStatus   String? @map("to_status")

  fromUserUid  Int?    @map("from_user_uid")
  fromUsername String? @map("from_username")
  toUserUid    Int?    @map("to_user_uid")
  toUsername   String? @map("to_username")

  /// §4.5 requires who, when AND why on every forward — mandatory for FORWARD in the API.
  remarks         String?
  revisedEta      DateTime? @map("revised_eta")
  /// MERGE only: the other ticket in the pair, so the trail reads two-way.
  relatedTicketId Int?      @map("related_ticket_id")

  actorUid      Int?     @map("actor_uid")
  actorUsername String   @map("actor_username")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket        Ticket  @relation("TicketEventTicket", fields: [ticketId], references: [id])
  relatedTicket Ticket? @relation("TicketEventRelated", fields: [relatedTicketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([eventType, createdAt])
  @@map("ticket_event")
}

/// Change request converted from a ticket (§4.6). One per originating ticket.
///
/// Two-step by design: the desk PROPOSES (approvalStatus PENDING, ticket moves to
/// AWAITING_CR_APPROVAL) and Product/Ops APPROVES — only then is the ticket closed and the
/// item parked in the backlog. §4.6 is explicit that the support desk cannot unilaterally
/// park an item, so approval cannot be a field simply set at creation time.
model ChangeRequest {
  id       Int    @id @default(autoincrement())
  crNo     String @unique @default(dbgenerated("((('CR-'::text || to_char((CURRENT_DATE)::timestamp with time zone, 'YYYY'::text)) || '-'::text) || lpad((nextval('change_request_no_seq'::regclass))::text, 6, '0'::text))")) @map("cr_no")
  ticketId Int    @unique @map("ticket_id")

  title       String
  description String

  requestedByUid  Int       @map("requested_by_uid")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  approvalStatus  String    @default("PENDING") @map("approval_status") // PENDING | APPROVED | REJECTED
  approvedByUid   Int?      @map("approved_by_uid")
  approvedAt      DateTime? @map("approved_at")
  approvalRemarks String?   @map("approval_remarks")

  /// Only meaningful once approvalStatus = APPROVED.
  backlogStatus String? @map("backlog_status") // BACKLOG | PLANNED | IN_DEVELOPMENT | RELEASED | DROPPED
  targetRelease String? @map("target_release")

  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  updatedOn DateTime @default(now()) @updatedAt @map("updated_on")

  ticket      Ticket       @relation(fields: [ticketId], references: [id])
  requestedBy UserDetails  @relation("CrRequestedBy", fields: [requestedByUid], references: [uid])
  approvedBy  UserDetails? @relation("CrApprovedBy", fields: [approvedByUid], references: [uid], onDelete: Restrict)

  @@index([approvalStatus, requestedAt])
  @@map("change_request")
}

/// Automated document request (§4.7). Deliberately NOT a Ticket: no triage, no assignment,
/// no SLA clock.
///
/// deliverToEmail is resolved SERVER-SIDE from the matched client's registered email and is
/// never accepted from the request body. With no OTP step, that resolution IS the
/// verification — a caller-supplied address would make the control a no-op.
model ServiceRequest {
  id           Int       @id @default(autoincrement())
  requestNo    String    @unique @default(dbgenerated("((('SRQ-'::text || to_char((CURRENT_DATE)::timestamp with time zone, 'YYYY'::text)) || '-'::text) || lpad((nextval('service_request_no_seq'::regclass))::text, 6, '0'::text))")) @map("request_no")
  documentType String    @map("document_type") // LEDGER | MARGIN_REPORT | CONTRACT_NOTE
  /// Mandatory for LEDGER. Enforced by a CHECK constraint in the migration, which Prisma
  /// cannot express — mirror it in the zod schema so the user gets a field error, not a 500.
  clientCode   String?   @map("client_code")
  fromDate     DateTime? @map("from_date")
  toDate       DateTime? @map("to_date")

  requestedByUid Int    @map("requested_by_uid")
  forClientUid   Int?   @map("for_client_uid")
  channel        String

  deliverToEmail String  @map("deliver_to_email")
  /// Employee-raised requests CC the client, so a document pulled on their account is
  /// always visible to them (§4.7).
  ccEmail        String? @map("cc_email")

  /// Which ReportDefinition produced the delivered PDF. Recorded because this flow replaces
  /// an OTP-verified one: "which query generated the document we emailed" has to be
  /// answerable long after the fact.
  reportId String? @map("report_id")

  status        String    @default("PENDING") // PENDING | GENERATED | SENT | FAILED
  requestedAt   DateTime  @default(now()) @map("requested_at")
  generatedAt   DateTime? @map("generated_at")
  deliveredAt   DateTime? @map("delivered_at")
  failureReason String?   @map("failure_reason")

  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  updatedOn DateTime @default(now()) @updatedAt @map("updated_on")

  requestedBy UserDetails       @relation("SrRequestedBy", fields: [requestedByUid], references: [uid])
  forClient   UserDetails?      @relation("SrForClient", fields: [forClientUid], references: [uid], onDelete: Restrict)
  report      ReportDefinition? @relation(fields: [reportId], references: [reportId], onDelete: Restrict)
  messages    ChannelMessage[]

  @@index([status, requestedAt])
  @@index([requestedByUid, requestedAt])
  @@index([clientCode, documentType])
  @@map("service_request")
}

/// Outbound queue + inbound log. Not in BRS §6, but Phase 1 cannot be built without it:
/// §4.2 sends a registration notification, §4.7 emails a PDF, and WhatsApp needs both
/// directions. Synapse has no delivery infrastructure today (forgot-userid and
/// reset-password are capture-only), so rows are written QUEUED and nothing transmits until
/// a provider is wired behind sendMessage().
///
/// Both directions share one table, so a ticket's WhatsApp thread is just this table
/// ordered by createdAt.
model ChannelMessage {
  id        Int    @id @default(autoincrement())
  direction String // INBOUND | OUTBOUND
  channel   String // EMAIL | SMS | WHATSAPP
  purpose   String // TICKET_REGISTERED | STATUS_UPDATE | CR_CLOSURE | DOCUMENT_DELIVERY | INBOUND_INTAKE

  ticketId         Int? @map("ticket_id")
  serviceRequestId Int? @map("service_request_id")

  counterparty String  @map("counterparty") // email address or E.164 mobile
  ccList       String? @map("cc_list")
  subject      String?
  body         String

  /// The provider's own id. Unique is what makes WhatsApp intake idempotent: the Cloud API
  /// redelivers a webhook on any non-2xx, and without this a slow response creates
  /// duplicate tickets that then trip our own §4.4 duplicate detection. NULL until sent —
  /// Postgres permits many NULLs in a unique column, so queued rows do not collide.
  providerMessageId String? @unique @map("provider_message_id")
  /// WhatsApp template used when replying outside the 24-hour customer service window.
  templateName      String? @map("template_name")

  status        String    @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | RECEIVED
  attempts      Int       @default(0)
  sentAt        DateTime? @map("sent_at")
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  ticket         Ticket?         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([ticketId, createdAt])
  @@index([serviceRequestId])
  @@map("channel_message")
}
